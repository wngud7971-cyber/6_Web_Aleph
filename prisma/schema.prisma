// 플랜두씨 다이어리 데이터 모델
// 날짜(기간, 마감일)는 "YYYY-MM-DD" 문자열로 저장한다 (시간대 혼선을 피하기 위해).
// 시각(생성/시작/종료 등)은 DateTime(UTC)으로 저장하고, 화면에서 Asia/Seoul로 변환해 보여준다.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 가입한 사람 한 명. 비밀번호는 절대 원문으로 저장하지 않고 bcrypt 해시만 저장한다.
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  plans        Plan[]
  events       Event[]
  insights     Insight[]
  sessions     Session[]
  ruleChanges  RuleChange[]
}

// 로그인 세션. 쿠키에는 무작위 토큰 원문을 담고, 여기(DB)에는 그 토큰의 SHA-256
// 해시만 저장한다 (DB가 유출돼도 쿠키 값을 복원할 수 없게). 서명용 비밀키를
// 따로 쓰지 않기 때문에 "비밀키가 코드/배포파일/Git에 없다"는 애초에 성립한다.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Plan {
  id              String         @id @default(cuid())
  // 소유자. 6번(인증 이전) 자료 이전을 위해 당분간 nullable로 둔다 — 자세한 이유는
  // 인증 구현 설명서 ⑥(아직 못 막은 것)에 적어 둔다. 모든 조회/생성 코드가 항상
  // userId로 걸러내는 것으로 실제 격리를 보장한다.
  userId          String?
  user            User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  periodStart     String // YYYY-MM-DD
  periodEnd       String // YYYY-MM-DD
  priority        String
  successCriteria String
  estimatedHours  Float
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  todos           Todo[]
  revisions       PlanRevision[]
  ruleChanges     RuleChange[]

  @@index([userId])
}

// 계획을 고칠 때마다 "고치기 전" 값을 스냅샷으로 남긴다.
model PlanRevision {
  id              String   @id @default(cuid())
  planId          String
  plan            Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  title           String
  periodStart     String
  periodEnd       String
  priority        String
  successCriteria String
  estimatedHours  Float
  capturedAt      DateTime @default(now())

  @@index([planId])
}

model Todo {
  id               String            @id @default(cuid())
  planId           String
  plan             Plan              @relation(fields: [planId], references: [id], onDelete: Cascade)
  title            String
  content          String?
  dueDate          String? // YYYY-MM-DD
  priority         String
  tags             String // 쉼표로 구분된 태그
  estimatedMinutes Float
  status           String            @default("todo") // "todo" | "done"
  completedAt      DateTime?
  deletedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  executionLogs    ExecutionLog[]
  completionEvents CompletionEvent[]

  @@index([planId])
}

// 완료/되돌리기 전환 이력. 원자적 업데이트(status 조건부 갱신)로만 생성되므로
// 완료 버튼을 연달아 눌러도 한 건만 쌓인다.
model CompletionEvent {
  id        String   @id @default(cuid())
  todoId    String
  todo      Todo     @relation(fields: [todoId], references: [id], onDelete: Cascade)
  action    String // "complete" | "uncomplete"
  createdAt DateTime @default(now())

  @@index([todoId])
}

model ExecutionLog {
  id            String   @id @default(cuid())
  todoId        String
  todo          Todo     @relation(fields: [todoId], references: [id], onDelete: Cascade)
  startedAt     DateTime
  endedAt       DateTime
  actualMinutes Float
  blockerReason String?
  createdAt     DateTime @default(now())

  @@index([todoId])
}

// 인사이트
model Insight {
  id              String   @id @default(cuid())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  note            String
  planId          String? // 이 인사이트가 나온 대상 계획(있다면)
  carriedToPlanId String? // 다음 계획으로 넘어간 경우 그 계획 id
  createdAt       DateTime @default(now())

  @@index([userId])
}

// 달력의 특정 날짜에 붙는 자유 메모/일정 (생일, 공휴일 등)
model Event {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String // YYYY-MM-DD
  title     String
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([userId])
}

// 계획을 쓰다가 규칙(성공 기준·지표 계산 방식 등)을 바꾼 시점을 명시적으로 남긴다.
// Plan.update는 이미 PlanRevision으로 "고치기 전 값"을 스냅샷 남기지만,
// "왜 바꿨는지"는 별도로 사람이 적어야 하므로 이 테이블에 붙여 남긴다.
model RuleChange {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId    String
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  reason    String
  changedAt DateTime @default(now())

  @@index([userId])
  @@index([planId])
}
