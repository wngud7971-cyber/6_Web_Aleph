// 플랜두씨 다이어리 데이터 모델
// 날짜(기간, 마감일)는 "YYYY-MM-DD" 문자열로 저장한다 (시간대 혼선을 피하기 위해).
// 시각(생성/시작/종료 등)은 DateTime(UTC)으로 저장하고, 화면에서 Asia/Seoul로 변환해 보여준다.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Plan {
  id              String         @id @default(cuid())
  title           String
  periodStart     String // YYYY-MM-DD
  periodEnd       String // YYYY-MM-DD
  priority        String
  successCriteria String
  estimatedHours  Float
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  todos           Todo[]
  revisions       PlanRevision[]
}

// 계획을 고칠 때마다 "고치기 전" 값을 스냅샷으로 남긴다.
model PlanRevision {
  id              String   @id @default(cuid())
  planId          String
  plan            Plan     @relation(fields: [planId], references: [id])
  title           String
  periodStart     String
  periodEnd       String
  priority        String
  successCriteria String
  estimatedHours  Float
  capturedAt      DateTime @default(now())

  @@index([planId])
}

model Todo {
  id               String            @id @default(cuid())
  planId           String
  plan             Plan              @relation(fields: [planId], references: [id])
  title            String
  content          String?
  dueDate          String? // YYYY-MM-DD
  priority         String
  tags             String // 쉼표로 구분된 태그
  estimatedMinutes Float
  status           String            @default("todo") // "todo" | "done"
  completedAt      DateTime?
  deletedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  executionLogs    ExecutionLog[]
  completionEvents CompletionEvent[]

  @@index([planId])
}

// 완료/되돌리기 전환 이력. 원자적 업데이트(status 조건부 갱신)로만 생성되므로
// 완료 버튼을 연달아 눌러도 한 건만 쌓인다.
model CompletionEvent {
  id        String   @id @default(cuid())
  todoId    String
  todo      Todo     @relation(fields: [todoId], references: [id])
  action    String // "complete" | "uncomplete"
  createdAt DateTime @default(now())

  @@index([todoId])
}

model ExecutionLog {
  id            String   @id @default(cuid())
  todoId        String
  todo          Todo     @relation(fields: [todoId], references: [id])
  startedAt     DateTime
  endedAt       DateTime
  actualMinutes Float
  blockerReason String?
  createdAt     DateTime @default(now())

  @@index([todoId])
}

// 인사이트
model Insight {
  id              String   @id @default(cuid())
  note            String
  planId          String? // 이 인사이트가 나온 대상 계획(있다면)
  carriedToPlanId String? // 다음 계획으로 넘어간 경우 그 계획 id
  createdAt       DateTime @default(now())
}

// 달력의 특정 날짜에 붙는 자유 메모/일정 (생일, 공휴일 등)
model Event {
  id        String   @id @default(cuid())
  date      String // YYYY-MM-DD
  title     String
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}
